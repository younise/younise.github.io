---
permalink: /assets/img/favicons/site.webmanifest
published: false
---
{% comment %}Suppress local manifest duplicate; rely on theme version.{% endcomment %}---
layout: compress
permalink: /assets/img/favicons/site.webmanifest
---
{% comment %}
Dynamic webmanifest leveraging site metadata. Replaces the static JSON file.
{% endcomment %}
{% assign favicon_path = "/assets/img/favicons" | relative_url %}
{
  "name": "{{ site.title | escape }}",
  "short_name": "{{ site.title | escape }}",
  "description": "{{ site.description | strip_newlines | escape }}",
  "icons": [
    {
      "src": "{{ favicon_path }}/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ favicon_path }}/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#2a1e6b",
  "background_color": "#ffffff",
  "display": "standalone"
}
